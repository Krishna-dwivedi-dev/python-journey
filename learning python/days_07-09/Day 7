# Q3: SecretDiary Class - PIN Protected
# ==========================================
class SecretDiary:
    def __init__(self, pin):
        self.__entry = ""
        self.__pin = pin

    def write_entry(self, pin, text):
        if pin == self.__pin:
            self.__entry = text
        else:
            print("Wrong PIN!")

    def read_entry(self, pin):
        if self.__pin == pin:
            return self.__entry
        else:
            print("Access Denied!")

    def change_pin(self, old_pin, new_pin):
        if self.__pin == old_pin:
            self.__pin = new_pin
        else:
            print("old_pin is Incorrect!")

s1 = SecretDiary("Krishna9")
s2 = SecretDiary("ansh12")    
s1.write_entry("Krishna9", "Hello! I'm Krishna Dwivedi") 
s2.write_entry("ansh12", "Hello! I'm ansh dwivedi")  
s1.change_pin("Krishna9", "Rahul9274")   
s2.change_pin("ansh12", "Devloper1")  
print(s1.read_entry("Rahul9274"))
print(s2.read_entry("Devloper1"))