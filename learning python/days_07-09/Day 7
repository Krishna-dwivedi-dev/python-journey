# ==========================================
# Q1: Student Class - Private Marks
# ==========================================
class Student:
    def __init__(self, name, marks):
        self.__name = name 
        self.__marks = marks

    def get_name(self):
        return self.__name

    def get_marks(self):
        return self.__marks

    def set_marks(self, marks):
        if marks < 0 or marks > 100:
            print("Invalid Marks")  
        else:
            self.__marks = marks  

Student1 = Student("Krishna Dwivedi", 94) 
print(Student1.get_name())
print(Student1.get_marks())
Student1.set_marks(90)
print(Student1.get_marks())


# ==========================================
# Q2: Password Class - Private Password
# ==========================================
class Password:
    def __init__(self):
        self.__password = None

    def set_password(self, p):
        if len(p) >= 8 and any(char.isdigit() for char in p):
            self.__password = p
        else:
            print("Weak Password!")

    def get_password(self):
        return self.__password

p1 = Password()
p1.set_password("abc")         # Weak - too short
p1.set_password("abcdefg1")   # Valid
print(p1.get_password())


